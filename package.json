{
	"name": "jzimhttp",
	"version": "1.0.1",
	"description": "HTTP server for ZIM files — browser UI and MCP tools",
	"type": "module",
	"main": "dist/main.js",
	"bin": {
		"jzimhttp": "dist/main.js"
	},
	"scripts": {
		"build": "node build.mjs all",
		"build:daemon": "node build.mjs daemon",
		"build:tests": "node build.mjs tests",
		"tests": "c8 --reporter=text --reporter=lcov ava --verbose"
	},
	"ava": {
		"files": [
			"tests/dist/**/*.test.js"
		],
		"timeout": "30s"
	},
	"dependencies": {
		"@hono/node-server": "~1",
		"@openzim/libzim": "~4",
		"hono": "~4",
		"node-html-parser": "~7",
		"turndown": "~7"
	},
	"devDependencies": {
		"@types/node": "~22",
		"@types/turndown": "~5",
		"ava": "~6",
		"c8": "~12",
		"typescript": "~6"
	}
}
